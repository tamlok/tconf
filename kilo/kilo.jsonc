{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "github-copilot/gpt-6-astra",
  "small_model": "github-copilot/gpt-5.6-luna",
  "agent": {
    "build": {
      "model": "github-copilot/gpt-6-astra",
      "variant": "high"
    },
    "plan": {
      "model": "github-copilot/gpt-6-astra",
      "variant": "high"
    }
  },
  "theme": "everforest",
  "snapshot": false,
  "permission": {
    "*": "allow",
    "bash": "allow"
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "headers": {
          "Copilot-Integration-Id": "copilot-developer-cli",
          "X-GitHub-Api-Version": "2026-06-01",
          "User-Agent": "copilot/1.0.64"
        }
      },
      "models": {
        "gpt-6-astra": {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gemini-3.1-pro-preview": {
          "id": "gemini-3.1-pro-preview",
          "name": "Gemini 3.1 Pro Preview",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "input": 936000,
            "output": 64000
          }
        }
      }
    }
  }
}
